      <Column Name="CreatedAt" Type="System.DateTime" DbType="DateTime2 NOT NULL" CanBeNull="false" />
      <Association Name="User_Resource" Member="Resources" ThisKey="UserId" OtherKey="UserId" Type="Resource" />
      <Association Name="User_Download" Member="Downloads" ThisKey="UserId" OtherKey="UserId" Type="Download" />
    </Type>
  </Table>
  <Table Name="dbo.Subjects" Member="Subjects">
    <Type Name="Subject">
